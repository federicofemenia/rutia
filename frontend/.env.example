VITE_API_URL=http://localhost:3000

# Maps JavaScript API + Places API. Restringir por HTTP referrer (el dominio de la app) en Google
# Cloud Console, con "API restrictions" habilitando únicamente Maps JavaScript API y Places API.
# Ver docs/google-migration.md.
VITE_GOOGLE_MAPS_BROWSER_API_KEY=

# Map ID (gratuito, se crea en Cloud Console > Google Maps Platform > Map Management), necesario
# para usar AdvancedMarker.
VITE_GOOGLE_MAPS_MAP_ID=
